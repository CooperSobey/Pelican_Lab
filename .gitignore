# Virtual environments
venv/
.venv/
env/
ENV/

# Python bytecode and caches
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/

# Pelican build output
output/
cache/
*.pid
pelican.pid
srv.pid

# Node (if you ever use npm tooling)
node_modules/

# Packaging / build artifacts
build/
dist/
*.egg-info/

# Editor and OS junk
.vscode/
.idea/
.DS_Store
Thumbs.db